<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Pinned to match the version fuzz-prep-multi.py's generated Dockerfile stages
         install (sharpfuzz_version); 2.0.0 predates SharpFuzz.Options and doesn't build. -->
    <PackageReference Include="SharpFuzz" Version="2.1.1" />
    <!-- Top-20+ #21: independent Cecil pass (CmpLogInstrumentor) that instruments
         comparison call sites; unrelated to SharpFuzz's own IL rewrite, which is a
         self-contained black box (SharpFuzz.Fuzzer.Instrument) we don't get to hook. -->
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>
  <ItemGroup>
    <!-- Exposes internal static classes (NamespaceMatcher, InstrumentationFilter,
         ConstantExtractor/CmpLogInstrumentor's helper methods) to instrumentor.Tests
         without making them part of this tool's public surface. -->
    <InternalsVisibleTo Include="instrumentor.Tests" />
  </ItemGroup>
</Project>
