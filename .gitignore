# ── .NET build artifacts ──────────────────────────────────────────────────────
bin/
obj/
*.dll
*.pdb
*.exe

# ── RESTler Extracted Binaries ─────────────────────────────────────────────────
restler_bin/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
void/venv/
*.egg-info/

# ── Go binaries (keep source, exclude compiled binaries) ─────────────────────
void/go/smartfuzzergo*
void/go/void*
# But keep pre-built Darwin arm64 binary if you want to ship it:
# !void/go/smartfuzzergo-darwin-arm64

# ── Fuzzer run output ─────────────────────────────────────────────────────────
void/crashes/
void/summaries/
void/logs/
void/fuzzer/

# ── Generated grammar artifacts (produced by compile-grammar.sh + deploy-grammar.sh) ──
# These are generated per-project and should NOT be committed.
grammars/
void/grammar.py
void/dict.json
void/templates.export.json
void/templates.helpdesk.json
void/templates.export.public.json

# ── RESTler runtime output ────────────────────────────────────────────────────
restler_output/
restler_input/
restler_runs/

# ── Local Swagger & Dictionaries ──────────────────────────────────────────────
swagger*.json
*-dictionary.json

# ── Instrumented project copies (generated by fuzz-prep-multi.py) ─────────────
prepared-*/
*-prepared/
loyalty-prep/
eshprep/
crashes/

# ── Target project source clones (large, not part of this tool) ──────────────

btcpayserver/
btcpayserver_prep/
examples/
fix_swagger_paths.py
simplcommerce_prep/
nopCommerce/


# ── Docker build cache ────────────────────────────────────────────────────────
*.tar
*.zip

