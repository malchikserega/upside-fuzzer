# ── OS / IDE ──────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
.vs/
.vscode/
.idea/
*.user
*.suo
*.swp
*~

# ── .NET build artifacts ──────────────────────────────────────────────────────
bin/
obj/
*.dll
*.pdb
*.exe
# Keep the RESTler .dll (it IS the tool, not a build artifact):
!restler_bin/**/*.dll

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
smart_fuzzer/venv/
*.egg-info/

# ── Go binaries (keep source, exclude compiled binaries) ─────────────────────
smart_fuzzer/go/smartfuzzergo
smart_fuzzer/go/smartfuzzergo-*
# But keep pre-built Darwin arm64 binary if you want to ship it:
# !smart_fuzzer/go/smartfuzzergo-darwin-arm64

# ── Fuzzer run output ─────────────────────────────────────────────────────────
smart_fuzzer/crashes/
smart_fuzzer/summaries/
smart_fuzzer/logs/
smart_fuzzer/fuzzer/

# ── Generated grammar artifacts (produced by compile-grammar.sh + deploy-grammar.sh) ──
# These are generated per-project and should NOT be committed.
grammars/
smart_fuzzer/grammar.py
smart_fuzzer/dict.json
smart_fuzzer/templates.export.json
smart_fuzzer/templates.helpdesk.json
smart_fuzzer/templates.export.public.json

# ── RESTler runtime output ────────────────────────────────────────────────────
restler_output/
restler_input/
restler_runs/

# ── Instrumented project copies (generated by fuzz-prep-multi.py) ─────────────
prepared-*/
*-prepared/
loyalty-prep/

# ── Target project source clones (large, not part of this tool) ──────────────
mpt-helpdesk/
mpt-currency/
nopCommerce/
mpt-prepared/

# ── Docker build cache ────────────────────────────────────────────────────────
*.tar
*.zip
mpt-prepared.zip

# ── Temp / scratch ────────────────────────────────────────────────────────────
*.tmp
*.log
nohup.out
