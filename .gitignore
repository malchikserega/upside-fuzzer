# ── Secrets / credentials (NEVER commit) ──────────────────────────────────────
# fuzzer.env holds live session cookies / auth tokens used at runtime.
*.env
fuzzer.env
*.secret
*_cookies.txt
# Real auth-identity files carry live tokens. Commit only *.example.json templates.
auth-identities.json
auth_file.json
auth.identities.json
!*.example.json

# ── Vendored / instrumented target repositories ───────────────────────────────
# Per-target prep trees are large (GBs) and are checked out per run, not tracked.
*_prep/

# ── OS / IDE ──────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
.vs/
.vscode/
.idea/
*.user
*.suo
*.swp
*~

# ── .NET build artifacts ──────────────────────────────────────────────────────
# bin/ (bare, no leading slash) matches a directory literally named "bin" at
# ANY depth -- e.g. tools/dotnet/instrumentor/bin/, fixtures/demo-app/src/*/bin/.
# The repo also has a genuinely TRACKED top-level /bin/ (shell/Python
# entrypoint scripts: compile-grammar.sh, fuzz-prep-multi.py, verify-hook.sh,
# bin/compatibility/ wrappers -- see docs/guides/repo-layout.md) which is NOT
# a build-artifact directory, so it's explicitly re-included below. Do not
# remove that negation or the root bin/ silently stops being tracked.
bin/
!/bin/
obj/
*.dll
*.pdb
*.exe

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
*.egg-info/

# ── Go binaries (keep source, exclude compiled binaries) ─────────────────────
# Go source moved from void/go/ to cmd/void/ + internal/ (repo-architecture
# refactor), then from repo root to src/void/ (self-contained-module refactor,
# 2026-07-31: src/void/{go.mod,go.sum,cmd/void/,internal/}) -- binaries still
# build in-place next to main.go.
src/void/cmd/void/smartfuzzergo*
src/void/cmd/void/void*
# But keep pre-built Darwin arm64 binary if you want to ship it:
# !src/void/cmd/void/smartfuzzergo-darwin-arm64

# ── Generated grammar artifacts (produced by compile-grammar.sh + deploy-grammar.sh) ──
# These are generated per-project and should NOT be committed.
grammars/

# ── Local Swagger & Dictionaries ──────────────────────────────────────────────
swagger*.json
*-dictionary.json
# fixtures/demo-app/swagger.json is a deliberately committed reference snapshot,
# not an ad-hoc downloaded spec -- see fixtures/demo-app/README.md's Bring-up section.
!fixtures/demo-app/swagger.json

# ── Instrumented project copies (generated by fuzz-prep-multi.py) ─────────────
prepared-*/
*-prepared/
crashes/
summaries/

# NOTE: examples/ is intentionally NOT ignored -- it holds small, hand-written,
# per-target helper scripts (examples/<target>/*.py) that QUICKSTART_*.md docs
# reference directly and that fuzz-prep-multi.py does not generate. Do not
# re-add a blanket ignore here; it previously made these scripts untracked
# despite being required steps in the documented pipeline.

# ── .work/ -- the consolidated home for local, gitignored working state ──────
# (target sources/prepared copies, compiled grammars, downloaded specs, run
# output -- crashes/summaries/checkpoints -- and secrets/auth files). Added
# 2026-07-31 alongside the repo-architecture cleanup; see .work/README.md for
# the full layout and a safe, opt-in migration guide from the older loose
# root-level patterns above (bitwarden_*/, crashes/, summaries/, grammars/,
# swagger*.json, etc.) -- those old patterns are INTENTIONALLY left in place
# and untouched, so any local checkout using them keeps working exactly as
# before; nothing here moves or deletes existing local data automatically.
.work/*
!.work/README.md


# ── Docker build cache ────────────────────────────────────────────────────────
*.tar
*.zip

# ── Temp / scratch ────────────────────────────────────────────────────────────
*.tmp
*.log
nohup.out

benchmarks/
.cursorrules
examples/
