#!/usr/bin/env bash
#
# upsidefuzz — zero-install launcher for the upsidefuzz CLI (Top-20 #19).
#
# Runs upsidefuzz.py inside the upsidefuzz-cli Docker image (Dockerfile.cli),
# which bundles Python, the .NET SDK (for the Roslyn analyzer), and a prebuilt
# `void` binary — so the only thing you need installed locally is Docker.
#
# Docker-outside-of-Docker: mounts the host Docker socket so `docker compose`
# commands issued *inside* this container control containers on your actual
# host, and bind-mounts your current directory at the SAME absolute path so
# relative paths in generated compose files resolve correctly on both sides
# (the daemon that ultimately runs `docker compose build/up` is the HOST
# daemon, not one inside this container).
#
# Usage:
#   ./upsidefuzz <subcommand> ...            # e.g. ./upsidefuzz doctor
#   ./upsidefuzz run --src ... --out ... ... # full pipeline, zero local installs
#
# Escape hatches:
#   ./upsidefuzz --no-docker <subcommand> ...   # run upsidefuzz.py natively instead
#   UPSIDEFUZZ_NO_DOCKER=1 ./upsidefuzz ...      # same, via env var
#   UPSIDEFUZZ_IMAGE=myimage:tag ./upsidefuzz ... # use a prebuilt/pulled image
#
# This script (and the image it runs) is purely additive: running the
# individual tools directly (python3 fuzz-prep-multi.py, compile-grammar.sh,
# verify-hook.sh, void) keeps working exactly as documented in
# docs/INSTRUCTIONS.md/QUICKSTART_*.md, with or without this launcher.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ "${1:-}" == "--no-docker" ]] || [[ "${UPSIDEFUZZ_NO_DOCKER:-}" == "1" ]]; then
    [[ "${1:-}" == "--no-docker" ]] && shift
    exec python3 "$ROOT/upsidefuzz.py" "$@"
fi

command -v docker >/dev/null 2>&1 || {
    echo "docker is required (or use --no-docker / UPSIDEFUZZ_NO_DOCKER=1 with python3 installed locally)." >&2
    exit 1
}

IMAGE="${UPSIDEFUZZ_IMAGE:-upsidefuzz-cli:latest}"

if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
    echo "Building the upsidefuzz CLI image (first run only; cached afterwards)..." >&2
    docker build -t "$IMAGE" -f "$ROOT/Dockerfile.cli" "$ROOT" >&2
fi

TTY_FLAGS="-i"
[[ -t 1 ]] && TTY_FLAGS="-it"

# `docker run` does NOT inherit your shell's environment automatically --
# forward AUTH_TOKEN/AUTH_FILE explicitly if set, so the
# `export $(cat fuzzer.env | xargs)` pattern used by several QUICKSTART_*.md
# docs (e.g. Bitwarden) works the same way in Docker mode as it does natively.
ENV_FLAGS=()
[[ -n "${AUTH_TOKEN:-}" ]] && ENV_FLAGS+=(-e "AUTH_TOKEN=${AUTH_TOKEN}")
[[ -n "${AUTH_FILE:-}" ]] && ENV_FLAGS+=(-e "AUTH_FILE=${AUTH_FILE}")

# --add-host is the Linux equivalent of Docker Desktop's built-in
# host.docker.internal resolution (harmless no-op on Desktop, where it's
# already provided natively) -- see upsidefuzz.py::_containerize_url for why
# this matters: this container and the target's containers are Docker
# siblings, so "localhost" in here is never the host's localhost.
#
# ENV_FLAGS is expanded via a guarded loop, not a bare "${ENV_FLAGS[@]}" --
# that throws "unbound variable" under `set -u` on bash < 4.4 (macOS's system
# /bin/bash is 3.2) even for a declared-but-empty array, the same bash-3.2
# quirk fixed in compile-grammar.sh/verify-hook.sh this session.
DOCKER_RUN_ARGS=(--rm)
[[ "$TTY_FLAGS" == "-it" ]] && DOCKER_RUN_ARGS+=(-i -t) || DOCKER_RUN_ARGS+=(-i)
DOCKER_RUN_ARGS+=(
    -v /var/run/docker.sock:/var/run/docker.sock
    -v "$(pwd):$(pwd)"
    -w "$(pwd)"
    -e "HOME=${HOME:-/root}"
    --add-host=host.docker.internal:host-gateway
)
if [ ${#ENV_FLAGS[@]} -gt 0 ]; then
    DOCKER_RUN_ARGS+=("${ENV_FLAGS[@]}")
fi

exec docker run "${DOCKER_RUN_ARGS[@]}" "$IMAGE" "$@"
